# ==============================================================================
# PrintIt Monorepo Environment Configuration Template
# Copy this file to .env or create service-specific .env files in subdirectories.
# NEVER commit .env files containing real production secrets.
# ==============================================================================

# Backend Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Razorpay Payment Gateway (Server-Side Only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT Authentication
JWT_SECRET=generate_a_secure_64_character_random_hex_string_for_production

# Firebase Configuration
FIREBASE_PROJECT_ID=printit-4d823
FIREBASE_STORAGE_BUCKET=printit-4d823.firebasestorage.app
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Admin Seed Account
ADMIN_EMAIL=admin@printit.local
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=System Admin

# Frontend Client Environment Variables
VITE_API_URL=http://localhost:3000/api
VITE_CUSTOMER_APP_URL=http://localhost:3000
