# ==============================================================================
# PrintIt Shopkeeper Portal Frontend Environment Configuration
# Vite exposes variables prefixed with VITE_ to client bundle.
# WARNING: NEVER prefix secrets, private keys, or credentials with VITE_.
# ==============================================================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:3000/api

# Customer App Web URL (Used for generating shop QR codes & customer links)
VITE_CUSTOMER_APP_URL=http://localhost:3000
