# Database Connection String (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Server Port
PORT=3000

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Firebase Configuration
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Optional: inline service account JSON or base64 encoded string for cloud deployments
# FIREBASE_SERVICE_ACCOUNT=
