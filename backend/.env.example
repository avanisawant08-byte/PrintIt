# ==============================================================================
# PrintIt Backend Environment Configuration
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Database Connection (PostgreSQL / Supabase Transaction Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated list of origins or * for open dev access)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Razorpay Payment Gateway Credentials (Server-Side Only)
# Key ID: Publishable key sent to client for opening the payment checkout modal
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Key Secret: STRICTLY SERVER-SIDE. Never share or expose to frontend/clients.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=generate_a_secure_64_character_random_hex_string_for_production

# Firebase Configuration
FIREBASE_PROJECT_ID=printit-4d823
FIREBASE_STORAGE_BUCKET=printit-4d823.firebasestorage.app
# Optional: Inline JSON string or Base64 encoded Service Account credentials for cloud deployments (e.g., Render/Railway)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Admin Account Seed Defaults (Used by createAdmin.js utility)
ADMIN_EMAIL=admin@printit.local
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=System Admin

# Test Mode Payment Simulation (Set to true ONLY in CI/test environments)
# ALLOW_MOCK_PAYMENTS=false
